{
  "name": "discord-assistant",
  "version": "0.0.1",
  "description": "One Discord bot reaching an OpenAI-compatible endpoint from both text and voice",
  "private": true,
  "main": "src/index.js",
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/index.js",
    "test": "node --test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "shim": "python3 -u shim/claude_openai_shim.py"
  },
  "license": "BSD-3-Clause",
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "@google-cloud/pubsub": "^6.0.1",
    "discord.js": "^14.27.0",
    "google-auth-library": "^11.0.2",
    "libsodium-wrappers": "^0.8.4",
    "opusscript": "^0.0.8",
    "prism-media": "^1.3.5",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "eslint": "^9.39.1",
    "prettier": "^3.6.2"
  }
}
