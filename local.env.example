# Copy to local.env (gitignored) and adjust:  cp local.env.example local.env
#
# There is deliberately NO committed env file. Make variables override the
# environment, so a committed `export DISCORD_TOKEN=` would silently clobber
# whatever you exported in your shell — a trap worth not shipping.
# The bot token is never stored here, only the TeamVault key it is fetched from.

# Discord. The token itself is NEVER stored here — only the TeamVault key it is
# fetched from at run time (see the run target), matching go-skeleton's
# SENTRY_DSN_KEY pattern.
#
# Never add a secret to this file: Make `include`s it, and Make variables
# override the environment, so even an empty `export DISCORD_TOKEN=` here would
# silently clobber whatever you exported in your shell.
export DISCORD_TOKEN_KEY=aL5p3O
export ALLOWED_USER_IDS=197830250418274304

# Who may use the SLASH commands (session and voice control). A subset of
# ALLOWED_USER_IDS — everyone allowed keeps the @mention surface either way.
# Empty means no admins, never all of them.
export ADMIN_USER_IDS=197830250418274304

# Which guilds advertise slash commands at all. Empty = every guild the bot is
# in. Set it when the bot is in a guild where you are an ordinary member:
# Discord's visibility gate is permission-based, so a command gated on
# ManageGuild would be hidden from YOU there too, and advertising commands
# nobody present may use is worse than advertising none.
# export SLASH_COMMAND_GUILD_IDS=

# The swappable endpoint: MiniMax, or the Claude Code shim
export OPENAI_BASE_URL=http://127.0.0.1:8080/v1
export OPENAI_API_KEY=not-needed
export OPENAI_MODEL=claude-code

# speech-to-speech realtime socket (voice surface)
export S2S_URL=ws://127.0.0.1:8765/v1/realtime

# Voice capability. Default true. Set to 0 for a text-only instance: no
# join/leave slash commands, no connection to S2S_URL. Required wherever there
# is no GPU for speech-to-speech — which is every cluster node.
#export VOICE_ENABLED=0

# Force the wake phrase even in a solo call. Default off (an instance with
# nothing set answers unaddressed speech when it is alone, as before). Set to 1
# for an instance that must never auto-answer, e.g. the Star Citizen Assistant
# on a friends' server. Read by BOTH the bot and the shim; voice stays fully
# enabled, only the solo auto-answer is switched off.
#export VOICE_ALWAYS_WAKE=1

# Which Discord identity THIS bot is (personal, sc, boss, ...) — not which
# guild it serves. Unset reproduces the single-identity v0.16.0 behaviour
# exactly. Set it to give this bot its own persona in config.yaml's
# `identities:` block, keyed by this same name, regardless of how many
# guilds it serves or shares with another identity.
#export IDENTITY=sc

# Service
export HEALTH_HOST=0.0.0.0
export HEALTH_PORT=8081   # 8080 is the shim; avoid the collision
export LOG_LEVEL=info
export SHUTDOWN_TIMEOUT_MS=10000
export HISTORY_LIMIT=20

# Chat bridge: lets the shim post a spoken answer's full text back into the
# live voice call's channel (src/health.js POST /chat). Read by BOTH the bot
# (src/config.js) and the shim (claude_openai_shim.py) under this SAME name —
# generate one value and set it once here so `set -a` (see scripts/dev.sh)
# hands the identical secret to both processes. Never pass this by argv.
export CHAT_BRIDGE_TOKEN=change-me-to-a-random-value

# Docker / Kubernetes
export DOCKER_REGISTRY=docker.io
export CLUSTER_CONTEXT=test

# Build metadata (set by CI/CD)
export BUILD_GIT_VERSION=dev
export BUILD_GIT_COMMIT=none
export BUILD_DATE=unknown

# Where voice transcripts land. Must be readable by the shim, which runs
# Claude Code with cwd in the vault — so keep it inside the vault.
export TRANSCRIPT_DIR="$HOME/Documents/Obsidian/Personal/70 Source Material/Discord"
# export TRANSCRIBE=0              # disable transcription entirely
# export ANNOUNCE_TRANSCRIPTION=0  # join without saying it is recording

# Wake phrases for VOICE turns, comma-separated, matched as a PREFIX and
# case-insensitively. In a call the assistant hears everything an allowlisted
# speaker says, so without this it answers conversations meant for other people.
# The extra entries are speech-to-text mishearings of the first one — add the
# ones your own transcripts show, and remember each is a false-trigger risk.
# Empty disables the gate entirely (answers every utterance, the old behaviour).
# Typed messages are never gated: an @mention already addressed the bot.
export SHIM_WAKE_PHRASES="hey bot,hey bought,hey but,hi bot"

# Should speaking while the assistant is answering CANCEL that answer?
# Off by default (reverses speech-to-speech's own default). The cancel fires on
# the VAD's speech_started — before any words exist — so "okay" and "stop" are
# the same event and there is nothing to filter on. Spoken replies are capped at
# a couple of sentences anyway, so there is little to interrupt.
# Accepts 1/true/yes/on and 0/false/no/off (case-insensitive).
# export INTERRUPT_RESPONSE=true
