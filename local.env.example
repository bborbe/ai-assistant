# Copy to local.env (gitignored). Included after example.env, so anything here
# overrides the committed defaults.

# Talk to MiniMax instead of the Claude Code shim:
# export OPENAI_BASE_URL=https://api.minimax.io/v1
# export OPENAI_MODEL=MiniMax-M3
# export DISCORD_TOKEN_KEY=<teamvault-key-holding-the-minimax-key>

# Skip TeamVault entirely for a throwaway test:
# export DISCORD_TOKEN=...

# export LOG_LEVEL=debug
