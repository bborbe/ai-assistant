# Copy to local.env (gitignored) and adjust:  cp local.env.example local.env
#
# There is deliberately NO committed env file. Make variables override the
# environment, so a committed `export DISCORD_TOKEN=` would silently clobber
# whatever you exported in your shell — a trap worth not shipping.
# The bot token is never stored here, only the TeamVault key it is fetched from.

# Discord. The token itself is NEVER stored here — only the TeamVault key it is
# fetched from at run time (see the run target), matching go-skeleton's
# SENTRY_DSN_KEY pattern.
#
# Never add a secret to this file: Make `include`s it, and Make variables
# override the environment, so even an empty `export DISCORD_TOKEN=` here would
# silently clobber whatever you exported in your shell.
export DISCORD_TOKEN_KEY=aL5p3O
export ALLOWED_USER_IDS=197830250418274304

# The swappable endpoint: MiniMax, or the Claude Code shim
export OPENAI_BASE_URL=http://127.0.0.1:8080/v1
export OPENAI_API_KEY=not-needed
export OPENAI_MODEL=claude-code

# speech-to-speech realtime socket (voice surface)
export S2S_URL=ws://127.0.0.1:8765/v1/realtime

# Service
export HEALTH_HOST=0.0.0.0
export HEALTH_PORT=8081   # 8080 is the shim; avoid the collision
export LOG_LEVEL=info
export SHUTDOWN_TIMEOUT_MS=10000
export HISTORY_LIMIT=20

# Docker / Kubernetes
export DOCKER_REGISTRY=docker.io
export CLUSTER_CONTEXT=test

# Build metadata (set by CI/CD)
export BUILD_GIT_VERSION=dev
export BUILD_GIT_COMMIT=none
export BUILD_DATE=unknown
